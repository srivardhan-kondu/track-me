{
  "name": "track-me",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:setup": "prisma db push && tsx prisma/seed-catalog.ts && tsx prisma/seed.ts && tsx scripts/check-db.ts",
    "db:url": "node scripts/set-db-url.mjs",
    "check:ai": "node --import tsx --env-file=.env scripts/check-ai.ts",
    "check:storage": "node --import tsx --env-file=.env scripts/check-storage.ts",
    "env:vercel": "node scripts/vercel-env.mjs",
    "check:variance": "node --import tsx --env-file=.env scripts/check-variance.ts",
    "db:catalog": "tsx prisma/seed-catalog.ts",
    "check:exercises": "node --import tsx --env-file=.env scripts/check-exercises.ts",
    "payments": "node --import tsx --env-file=.env scripts/payments.ts",
    "webhook:test": "node --import tsx --env-file=.env scripts/webhook-test.ts",
    "seed:review": "node --import tsx --env-file=.env scripts/seed-review.ts",
    "links:audit": "node --import tsx --env-file=.env scripts/migrate-coach-links.ts",
    "jobs:drain": "node --import tsx --env-file=.env scripts/drain-jobs.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "next-auth": "5.0.0-beta.25",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
