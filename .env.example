# ---- Database ----
# DATABASE_URL is the pooled connection the app uses at runtime.
# DIRECT_URL is an unpooled connection used only for `db:push` / `db:seed`.
# For local Docker Postgres both are the same.
#
#   Neon      pooled host contains "-pooler"; direct host omits it
#   Supabase  pooled = port 6543 (append ?pgbouncer=true), direct = port 5432
#
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ---- Auth.js ----
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"
AUTH_URL="http://localhost:3000"
# Google OAuth. Leave blank in dev to use the dev sign-in fallback.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Object storage (S3-compatible) ----
# Cloudflare R2 by default. For any other S3-compatible store (Neon Object
# Storage, Supabase Storage, Backblaze B2, MinIO, AWS S3) set S3_ENDPOINT and
# S3_REGION instead of R2_ACCOUNT_ID, keeping the key and bucket vars below.
#
#   Neon Object Storage (us-east-2 only, public beta):
#     S3_ENDPOINT  https://br-<branch-id>.storage.c-2.us-east-2.aws.neon.tech
#     S3_REGION    us-east-2
#
# S3_ENDPOINT=""
# S3_REGION="auto"
# Leave blank to store uploads on the local filesystem (.uploads/) in dev.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional public CDN base, e.g. https://media.yourdomain.com
R2_PUBLIC_BASE_URL=""

# ---- OpenAI ----
# Leave blank to use the heuristic stub estimator instead of real AI.
OPENAI_API_KEY=""
OPENAI_TRANSCRIBE_MODEL="whisper-1"
OPENAI_VISION_MODEL="gpt-4o"

# ---- Razorpay ----
# Set in Dashboard → Settings → Webhooks when adding the endpoint
# (/api/webhooks/razorpay) for the events payment.captured and
# payment_link.paid. Test and live mode have separate URLs and secrets; this is
# the secret for whichever mode this deployment talks to. Leave blank to have
# the endpoint refuse every delivery.
RAZORPAY_WEBHOOK_SECRET=

# API keys for Checkout — the in-app payment sheet. Dashboard → Account &
# Settings → API Keys. `rzp_test_` keys take fake payments with test cards;
# `rzp_live_` keys take real money and need an activated account. The code is
# identical either way, so going live is a change of these two values.
# Leave blank to hide the payment sheet entirely.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
