# ---- Database ----
# DATABASE_URL is the pooled connection the app uses at runtime.
# DIRECT_URL is an unpooled connection used only for `db:push` / `db:seed`.
# For local Docker Postgres both are the same.
#
#   Neon      pooled host contains "-pooler"; direct host omits it
#   Supabase  pooled = port 6543 (append ?pgbouncer=true), direct = port 5432
#
#
# Append `connection_limit=1` to the POOLED url on any serverless host. Each
# warm instance keeps its own Prisma pool, so the default of several
# connections each is multiplied by however many instances the platform has
# running — which exhausts the Postgres connection ceiling long before traffic
# does. One per instance, with pgBouncer doing the actual pooling, is correct.
#
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ---- Auth.js ----
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"
AUTH_URL="http://localhost:3000"
# Google OAuth. Leave blank in dev to use the dev sign-in fallback.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Object storage (S3-compatible) ----
# Cloudflare R2 by default. For any other S3-compatible store (Neon Object
# Storage, Supabase Storage, Backblaze B2, MinIO, AWS S3) set S3_ENDPOINT and
# S3_REGION instead of R2_ACCOUNT_ID, keeping the key and bucket vars below.
#
#   Neon Object Storage (us-east-2 only, public beta):
#     S3_ENDPOINT  https://br-<branch-id>.storage.c-2.us-east-2.aws.neon.tech
#     S3_REGION    us-east-2
#
# S3_ENDPOINT=""
# S3_REGION="auto"
# Leave blank to store uploads on the local filesystem (.uploads/) in dev.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional public CDN base for assets that are genuinely public.
#
# NOT used for anything a user uploaded. Meal photos, progress photos and voice
# notes are always served through short-lived presigned URLs: an unauthenticated
# CDN link never expires and cannot be revoked, and the object keys are not
# secret (the data export returns them in plaintext). Pointing this at the
# media bucket would make every progress photo world-readable for ever.
PUBLIC_ASSET_BASE_URL=""

# ---- OpenAI ----
# A hard ceiling on what this key may spend per day, in USD. Past it, queued
# analysis is parked until the window rolls over rather than run — logging
# still works, the macros arrive the next day.
#
# This is the limit that matters at scale. The per-user rate limits bound what
# one athlete can do; they do nothing about ten thousand athletes each doing
# their allowance, and every sign-up gets a trial, so "users" means sign-ups.
# Start low, watch `budget` in the /api/jobs/run response, raise it knowingly.
AI_DAILY_BUDGET_USD=25

# List prices used to estimate that spend. Estimates for a safety rail, not
# billing — they only need the right order of magnitude, and erring high is the
# safe direction. Update them when the models or the pricing change.
AI_PRICE_INPUT_MTOK=2.5
AI_PRICE_OUTPUT_MTOK=10
AI_PRICE_WHISPER_MIN=0.006

# Leave blank to use the heuristic stub estimator instead of real AI.
OPENAI_API_KEY=""
OPENAI_TRANSCRIBE_MODEL="whisper-1"
OPENAI_VISION_MODEL="gpt-4o"

# ---- Razorpay ----
# Set in Dashboard → Settings → Webhooks when adding the endpoint
# (/api/webhooks/razorpay) for the events payment.captured and
# payment_link.paid. Test and live mode have separate URLs and secrets; this is
# the secret for whichever mode this deployment talks to. Leave blank to have
# the endpoint refuse every delivery.
RAZORPAY_WEBHOOK_SECRET=

# API keys for Checkout — the in-app payment sheet. Dashboard → Account &
# Settings → API Keys. `rzp_test_` keys take fake payments with test cards;
# `rzp_live_` keys take real money and need an activated account. The code is
# identical either way, so going live is a change of these two values.
# Leave blank to hide the payment sheet entirely.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Admin console ----
# Comma-separated addresses that may open /admin, whatever the database says.
#
# Admin is deliberately not a value of `role`: athletes switch their own role
# in Settings, so an ADMIN member of that enum would put the console one
# dropdown away from every account. It is a separate `isAdmin` column, granted
# from inside the console — plus this allowlist, which needs no database at
# all and is therefore the way back in after a restore, or when the last admin
# account was removed by mistake. Leave it set for at least one address you
# control.
#
#   npm run admin                    list every admin
#   npm run admin -- grant <email>   grant the column to an existing account
ADMIN_EMAILS=

# ---- Reviewer access ----
# A single password account for people who must inspect the deployed app but
# cannot be given a Google login — a payment gateway's activation reviewers.
# The provider only exists when BOTH are set, so clearing either one and
# redeploying removes the login. Remove them once the review is over.
REVIEW_EMAIL=
REVIEW_PASSWORD=

# ---- Background jobs ----
# The AI pipelines run as queued jobs rather than inside the upload request.
# A Vercel Cron hits /api/jobs/run every minute to drain whatever the upload
# path could not finish itself; this secret is what authorises that call.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# How many AI jobs may be in flight across the whole deployment at once. This
# is the backpressure valve — past it, jobs wait in the queue instead of being
# sent to OpenAI to be rejected. Size it to your OpenAI tier; the default suits
# tier 1 (500 RPM / 30k TPM) with vision payloads.
AI_MAX_IN_FLIGHT=20
