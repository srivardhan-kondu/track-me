// Track Me — fitness reporting platform
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection used by the app at runtime.
  url      = env("DATABASE_URL")
  // Direct (unpooled) connection; schema pushes cannot run through pgBouncer.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role      Role     @default(ATHLETE)
  heightCm  Float?
  /// IANA zone, detected in the browser. Date bucketing and every rendered
  /// time depend on it; the server's own zone is UTC in production.
  timeZone  String?
  createdAt DateTime @default(now())

  accounts Account[]
  sessions Session[]

  // A coach has many athletes; an athlete may have many coaches.
  coachLinks   CoachAthlete[] @relation("AthleteToCoach")
  athleteLinks CoachAthlete[] @relation("CoachToAthlete")

  meals          Meal[]
  workouts       Workout[]
  weightEntries  WeightEntry[]
  progressPhotos ProgressPhoto[]
  comments       Comment[]

  @@index([role])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

enum Role {
  ATHLETE
  COACH
}

/// Lifecycle of an AI-processed record.
enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Pose {
  FRONT
  SIDE
  BACK
}

/// Join table linking a coach to the athletes they monitor.
model CoachAthlete {
  id        String   @id @default(cuid())
  coachId   String
  athleteId String
  createdAt DateTime @default(now())

  coach   User @relation("CoachToAthlete", fields: [coachId], references: [id], onDelete: Cascade)
  athlete User @relation("AthleteToCoach", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@index([athleteId])
}

model Meal {
  id     String @id @default(cuid())
  userId String

  imageKey String?
  audioKey String?

  transcript String?
  title      String?
  slot       MealSlot?

  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?

  /// Raw per-ingredient breakdown returned by the vision model.
  items Json?

  status ProcessingStatus @default(PENDING)
  error  String?

  eatenAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([userId, eatenAt])
  @@index([status])
}

model Workout {
  id     String @id @default(cuid())
  userId String

  audioKey   String?
  transcript String?
  title      String?
  durationMin Int?
  notes      String?

  status ProcessingStatus @default(PENDING)
  error  String?

  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises Exercise[]
  comments  Comment[]

  @@index([userId, performedAt])
}

model Exercise {
  id        String @id @default(cuid())
  workoutId String

  name     String
  weightKg Float?
  sets     Int?
  reps     Int?
  /// Ordering within the workout as dictated.
  position Int    @default(0)

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

model WeightEntry {
  id     String @id @default(cuid())
  userId String

  weightKg Float
  photoKey String?
  notes    String?

  /// Date-only bucket so a user has at most one check-in per day.
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@unique([userId, day])
  @@index([userId, day])
}

model ProgressPhoto {
  id     String @id @default(cuid())
  userId String

  pose     Pose
  imageKey String
  takenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

/// Trainer (or athlete) feedback attached to exactly one logged record.
model Comment {
  id       String @id @default(cuid())
  authorId String
  body     String

  mealId        String?
  workoutId     String?
  weightEntryId String?

  createdAt DateTime @default(now())

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  meal        Meal?        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  workout     Workout?     @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  weightEntry WeightEntry? @relation(fields: [weightEntryId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@index([workoutId])
  @@index([weightEntryId])
}
