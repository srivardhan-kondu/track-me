// Track Me — fitness reporting platform
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection used by the app at runtime.
  url      = env("DATABASE_URL")
  // Direct (unpooled) connection; schema pushes cannot run through pgBouncer.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role      Role     @default(ATHLETE)
  heightCm  Float?

  /// Paid entitlement. A trial grants premium features without touching this,
  /// so `plan` only ever moves once money has actually arrived.
  plan          Plan      @default(FREE)
  planTerm      PlanTerm?
  /// Null on FREE, and null on LIFETIME — which never expires.
  planExpiresAt DateTime?
  /// Stamped on first sign-in. Premium features stay open until it passes.
  trialEndsAt   DateTime?

  /// IANA zone, detected in the browser. Date bucketing and every rendered
  /// time depend on it; the server's own zone is UTC in production.
  timeZone  String?
  createdAt DateTime @default(now())

  accounts Account[]
  sessions Session[]

  // A coach has many athletes; an athlete may have many coaches.
  coachLinks   CoachAthlete[] @relation("AthleteToCoach")
  athleteLinks CoachAthlete[] @relation("CoachToAthlete")

  payments       Payment[]
  meals          Meal[]
  workouts       Workout[]
  weightEntries  WeightEntry[]
  progressPhotos ProgressPhoto[]
  comments       Comment[]

  @@index([role])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

enum Role {
  ATHLETE
  COACH
}

/// Lifecycle of an AI-processed record.
enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Pose {
  FRONT
  SIDE
  BACK
}

/// Join table linking a coach to the athletes they monitor.
model CoachAthlete {
  id        String   @id @default(cuid())
  coachId   String
  athleteId String
  createdAt DateTime @default(now())

  coach   User @relation("CoachToAthlete", fields: [coachId], references: [id], onDelete: Cascade)
  athlete User @relation("AthleteToCoach", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@index([athleteId])
}

model Meal {
  id     String @id @default(cuid())
  userId String

  imageKey String?
  audioKey String?

  transcript String?
  title      String?
  slot       MealSlot?

  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?

  /// Raw per-ingredient breakdown returned by the vision model.
  items Json?

  status ProcessingStatus @default(PENDING)
  error  String?

  eatenAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([userId, eatenAt])
  @@index([userId, status])
}

model Workout {
  id     String @id @default(cuid())
  userId String

  audioKey   String?
  transcript String?
  title      String?
  durationMin Int?
  notes      String?

  status ProcessingStatus @default(PENDING)
  error  String?

  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises Exercise[]
  comments  Comment[]

  @@index([userId, performedAt])
  @@index([userId, status])
}

model Exercise {
  id        String @id @default(cuid())
  workoutId String

  name     String
  weightKg Float?
  sets     Int?
  reps     Int?
  /// Ordering within the workout as dictated.
  position Int    @default(0)

  /// Resolved catalog entry, when the movement was recognised. Null keeps an
  /// unrecognised exercise loggable rather than rejecting it.
  catalogId String?

  workout Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  catalog CatalogExercise? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  @@index([workoutId])
  @@index([catalogId])
}

// ---------------------------------------------------------------------------
// Exercise taxonomy
// ---------------------------------------------------------------------------

enum MovementPattern {
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  SQUAT
  HINGE
  LUNGE
  CARRY
  ROTATION
  ANTI_ROTATION
  GAIT
  JUMP
  SPRINT
  CRAWL
}

enum ExerciseType {
  COMPOUND
  ISOLATION
  POWER
  OLYMPIC
  CARDIO
  MOBILITY
  STRETCH
  REHABILITATION
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  SMITH_MACHINE
  BODYWEIGHT
  RESISTANCE_BAND
  KETTLEBELL
  TRAP_BAR
  EZ_BAR
  MEDICINE_BALL
  SUSPENSION_TRAINER
}

/// How much of the work a muscle does in a given exercise.
enum MuscleRole {
  PRIMARY
  SECONDARY
  STABILISER
}

model MuscleGroup {
  /// Stable identifier from the taxonomy (e.g. "MG001").
  id       String @id
  key      String @unique
  name     String
  position Int    @default(0)

  muscles Muscle[]
}

model Muscle {
  /// Stable identifier from the taxonomy (e.g. "M001").
  id       String @id
  name     String
  groupId  String
  position Int    @default(0)

  group     MuscleGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  exercises ExerciseMuscle[]

  @@index([groupId])
}

/// A known movement. Logged exercises resolve to one of these so volume can be
/// attributed to muscles.
model CatalogExercise {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// Spoken and written variants matched when resolving a dictated exercise.
  aliases String[]

  pattern   MovementPattern
  type      ExerciseType
  equipment Equipment

  /// Loads one side at a time, so per-set volume counts differently.
  isUnilateral Boolean @default(false)

  muscles ExerciseMuscle[]
  logged  Exercise[]

  @@index([pattern])
  @@index([equipment])
}

model ExerciseMuscle {
  catalogExerciseId String
  muscleId          String
  role              MuscleRole

  catalog CatalogExercise @relation(fields: [catalogExerciseId], references: [id], onDelete: Cascade)
  muscle  Muscle          @relation(fields: [muscleId], references: [id], onDelete: Cascade)

  @@id([catalogExerciseId, muscleId])
  @@index([muscleId])
}

model WeightEntry {
  id     String @id @default(cuid())
  userId String

  weightKg Float
  photoKey String?
  notes    String?

  /// Date-only bucket so a user has at most one check-in per day.
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@unique([userId, day])
  @@index([userId, day])
}

model ProgressPhoto {
  id     String @id @default(cuid())
  userId String

  pose     Pose
  imageKey String
  takenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

/// Trainer (or athlete) feedback attached to exactly one logged record.
model Comment {
  id       String @id @default(cuid())
  authorId String
  body     String

  mealId        String?
  workoutId     String?
  weightEntryId String?

  createdAt DateTime @default(now())

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  meal        Meal?        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  workout     Workout?     @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  weightEntry WeightEntry? @relation(fields: [weightEntryId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@index([workoutId])
  @@index([weightEntryId])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PREMIUM
}

/// The tiers sold through the Razorpay payment page. Identified by the exact
/// amount paid, since the page lets the buyer type any figure they like.
enum PlanTerm {
  MONTHLY
  YEARLY
  LIFETIME
}

/// What became of a captured payment.
///   APPLIED   attributed to a user, entitlement granted
///   UNMATCHED the payer's email matches no account — awaits reconciliation
///   IGNORED   the amount is not one of our prices (a test rupee, a tip)
enum PaymentStatus {
  APPLIED
  UNMATCHED
  IGNORED
}

/// One captured Razorpay payment.
model Payment {
  /// Razorpay's own payment id (`pay_...`) rather than a cuid: it is the
  /// idempotency key, so a redelivered webhook collides instead of granting
  /// a second entitlement.
  id String @id

  userId String?
  status PaymentStatus

  /// Paise, exactly as Razorpay reports it. Converting to rupees is a display
  /// concern, and doing it here would invite rounding into the money path.
  amount   Int
  currency String    @default("INR")
  term     PlanTerm?

  /// Razorpay order id (`order_...`) for a Checkout purchase. Null for money
  /// taken through the razorpay.me page, which creates no order.
  orderId String?

  /// Contact details as typed on the payment page. The email is the only link
  /// back to an account, and is not necessarily the one they signed in with.
  email   String?
  contact String?
  /// The page's required "Comment" field, where buyers are asked to put their
  /// sign-in email.
  note    String?

  /// Razorpay event name, kept to make redeliveries legible in the log.
  event String
  /// The untouched webhook body, so an UNMATCHED payment can be settled by
  /// hand months later without asking Razorpay for the record again.
  payload Json

  paidAt    DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

enum JobKind {
  MEAL_ANALYSIS
  WORKOUT_PARSE
}

enum JobState {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// A unit of expensive work — currently the two OpenAI round trips — moved out
/// of the request that created it.
///
/// The upload enqueues and returns; the model calls happen against this row.
/// That buys three things the previous `after()` call could not: a retry with
/// backoff when OpenAI rate-limits us, a lease so a killed invocation is
/// picked up again instead of stranding the record on PROCESSING, and a
/// terminal FAILED state a human can go and look at.
model Job {
  id     String  @id @default(cuid())
  kind   JobKind
  /// The Meal or Workout this job finishes. Unique per kind, so enqueueing
  /// twice for the same record collides rather than doubling the AI spend.
  targetId String
  userId   String

  /// Anything the job needs that is not on the target row — the typed
  /// description, which is not persisted until the transcript is resolved.
  payload Json?

  state       JobState @default(QUEUED)
  attempts    Int      @default(0)
  maxAttempts Int      @default(4)

  /// Earliest a worker may claim this. Pushed forward on each backoff.
  runAfter DateTime @default(now())
  /// Set when claimed. A RUNNING row past this was killed mid-flight and is
  /// free for another worker to take.
  leaseUntil DateTime?

  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, targetId])
  @@index([state, runAfter])
  @@index([userId])
}

/// One fixed rate-limit window.
///
/// Postgres rather than Redis because the database is already here and already
/// pooled: one upsert per check costs less than an extra service to operate.
/// `lib/rate-limit.ts` swaps to Upstash by changing its backend, not its
/// callers, if the write volume ever justifies it.
model RateLimit {
  /// "<bucket>:<identifier>:<window start>" — the window is baked into the key
  /// so a new window is a new row rather than a read-modify-write race.
  key   String @id
  count Int    @default(0)
  /// When this row stops counting. Swept by the job worker.
  expiresAt DateTime

  @@index([expiresAt])
}
